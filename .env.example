# ---- AI Tutor brain ----
# FREE option (recommended): Groq — get a free key at https://console.groq.com/keys
# No credit card needed. Powers /api/tutor, /api/translate and /api/stt.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional paid fallback (only used if GROQ_API_KEY is not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Optional: premium voice (client-side, used only if keys are provided) ----
# ElevenLabs text-to-speech for realistic AI voice (has a small free tier)
NEXT_PUBLIC_ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=

# ---- Optional: OpenAI Realtime API slot (PAID, OpenAI only — skip if using Groq) ----
# NEXT_PUBLIC_REALTIME_MODEL=gpt-4o-realtime-preview
