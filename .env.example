# ---- AI Tutor (server-side, used by /api/tutor) ----
# Primary: OpenAI (chat completions power the tutor's brain)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: OpenAI Realtime API (browser connects directly to wss with a session token)
# NEXT_PUBLIC_REALTIME_MODEL=gpt-4o-realtime-preview

# ---- Optional: premium voice (client-side, used only if keys are provided) ----
# ElevenLabs text-to-speech for realistic voice
NEXT_PUBLIC_ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=

# Whisper speech-to-text for high-accuracy transcription (server route /api/stt)
# OPENAI_STT_MODEL=whisper-1
